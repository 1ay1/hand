{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev: the edit-build-test loop (hand at -O0, mayag + toe at -O2, PCH, ccache, mold)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Dev", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_C_COMPILER": "clang" }
    },
    {
      "name": "rel",
      "displayName": "Release with symbols: shipping, --bench, --flood",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-rel",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "CMAKE_CXX_COMPILER": "clang++", "CMAKE_C_COMPILER": "clang" }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer: the self-test with every thread watched",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Dev",
        "CMAKE_CXX_COMPILER": "clang++", "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev",  "configurePreset": "dev",  "targets": ["hand"], "jobs": 12 },
    { "name": "rel",  "configurePreset": "rel",  "targets": ["hand"], "jobs": 12 },
    { "name": "tsan", "configurePreset": "tsan", "targets": ["hand"], "jobs": 12 }
  ],
  "testPresets": [
    { "name": "dev",  "configurePreset": "dev",  "execution": { "jobs": 12, "timeout": 150 } },
    { "name": "tsan", "configurePreset": "tsan", "filter": { "include": { "name": "app_headless" } },
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" },
      "execution": { "timeout": 600 } }
  ]
}
