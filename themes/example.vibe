# hand theme — copy this into ~/.config/hand/themes/ and edit.
# Every field is optional except background + foreground. It shows up in the
# settings Theme picker (⌘,) as its `name`, referenced in config as user:<file>.
#
#   theme user:example      # in ~/.config/hand/config.vibe

name       "Example"
dark       true             # true = dark UI chrome, false = light (auto if omitted)

# The four essentials.
background "#1e1e2e"
foreground "#cdd6f4"
cursor     "#f5e0dc"
selection  "#585b70"
accent     "#89b4fa"        # UI brand colour: titles, active tab, focus (defaults to bright_blue)

# The 16 ANSI colours, by NAME — no index-counting.
black   "#45475a"   red     "#f38ba8"   green   "#a6e3a1"   yellow  "#f9e2af"
blue    "#89b4fa"   magenta "#f5c2e7"   cyan    "#94e2d5"   white   "#bac2de"

bright_black   "#585b70"   bright_red     "#f37799"   bright_green   "#89d88b"
bright_yellow  "#ebd391"   bright_blue    "#74a8fc"   bright_magenta "#f2aede"
bright_cyan    "#6bd7ca"   bright_white   "#a6adc8"
