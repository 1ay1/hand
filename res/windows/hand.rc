// hand's Windows resources: the manifest (res/windows/hand.manifest) and the
// version block Explorer's Properties and the task manager read.
#include <winver.h>

1 24 "hand.manifest"   // CREATEPROCESS_MANIFEST_RESOURCE_ID, RT_MANIFEST

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0, 1, 0, 0
PRODUCTVERSION  0, 1, 0, 0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "hand"
            VALUE "FileDescription",  "hand terminal"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "hand"
            VALUE "OriginalFilename", "hand.exe"
            VALUE "ProductName",      "hand"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
